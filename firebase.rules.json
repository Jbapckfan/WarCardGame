{
  "rules": {
    ".read": false,
    ".write": false,

    "rooms": {
      ".read": "auth != null",
      "$roomId": {
        ".write": "auth != null && (!data.exists() || data.child('createdBy').val() == auth.uid || data.child('playerCount').val() < 2)"
      }
    },

    "games": {
      "$gameId": {
        ".read": "auth != null && (
          data.child('player1/id').val() == auth.uid ||
          data.child('player2/id').val() == auth.uid ||
          (data.child('players').exists() && data.child('players').val().hasChildren([auth.uid]))
        )",
        ".write": "auth != null && (
          data.child('player1/id').val() == auth.uid ||
          data.child('player2/id').val() == auth.uid ||
          (data.child('players').exists() && data.child('players').val().hasChildren([auth.uid]))
        )",
        ".validate": "newData.hasChildren(['id', 'gameStatus', 'lastActionTime'])"
      }
    },

    "goFishGames": {
      "$gameId": {
        ".read": "auth != null",
        ".write": "auth != null",
        ".validate": "newData.hasChildren(['id', 'gameStatus'])"
      }
    },

    "unoGames": {
      "$gameId": {
        ".read": "auth != null",
        ".write": "auth != null",
        ".validate": "newData.hasChildren(['id', 'gameStatus'])"
      }
    },

    "heartsGames": {
      "$gameId": {
        ".read": "auth != null",
        ".write": "auth != null",
        ".validate": "newData.hasChildren(['id', 'gameStatus'])"
      }
    },

    "phase10Games": {
      "$gameId": {
        ".read": "auth != null",
        ".write": "auth != null",
        ".validate": "newData.hasChildren(['id', 'gameStatus'])"
      }
    },

    "kingsGames": {
      "$gameId": {
        ".read": "auth != null",
        ".write": "auth != null",
        ".validate": "newData.hasChildren(['id', 'gameStatus'])"
      }
    },

    "turnTimers": {
      "$gameId": {
        ".read": "auth != null",
        ".write": "auth != null"
      }
    },

    "playerPresence": {
      "$gameId": {
        "$playerId": {
          ".read": "auth != null",
          ".write": "auth.uid == $playerId"
        }
      }
    }
  }
}
